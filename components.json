{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-nova",
  "rsc": [false,true],
  "tsx": [true,false],
  "tailwind": {
   "config": ["tailwind.config.ts", "tailwind.config.js"],
    "css": "styles/app.css",
    "baseColor": ["neutral", "stone", "zinc", "mauve", "olive", "mist", "taupe"],
    "cssVariables": [true,false],
    "prefix": "tw-"  
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {}
}
